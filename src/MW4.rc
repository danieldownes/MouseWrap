            VALUE "LegalCopyright", "GNU GPL v2"
            VALUE "OriginalFilename", "MW4.exe"
            VALUE "ProductName", "MouseWrap"
            VALUE "ProductVersion", "4.2"
        END
    END
    BLOCK "VarFileInfo"
